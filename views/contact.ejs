  .contact-info i {
    font-size: 1.2rem;
    color: #0d6efd;
  }
  
  .contact-info a {
    color: #0d6efd;
    text-decoration: none;
  }
  
  .contact-info a:hover {
    text-decoration: underline;
  }
</style>